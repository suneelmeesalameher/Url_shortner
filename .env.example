# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# docker-compose.yml reads these automatically. Everything here has a working
# default baked into docker-compose.yml too, so `docker compose up` works even
# without a .env file - this is only needed to override something (e.g. a real
# password before exposing the stack beyond your own machine).

# --- Postgres ---
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=url_shortener

# --- App ---
# Used to build the fully-qualified short_url in API responses - set this to
# whatever host/port clients will actually use to reach the app.
BASE_HOST=http://localhost:8000

# Token-bucket rate limits (see app/core/rate_limiter.py).
RATE_LIMIT_PER_IP_PER_MINUTE=100
RATE_LIMIT_PER_SHORTCODE_PER_MINUTE=1000
